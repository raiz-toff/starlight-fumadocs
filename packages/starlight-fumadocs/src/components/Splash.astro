---
/**
 * FumaDocs Splash/Hero component.
 * A responsive hero section with a colorful background glow.
 */
---

<div class="fumadocs-splash">
  <div class="splash-glow"></div>
  <div class="splash-content">
    <slot />
  </div>
</div>

<style>
  .fumadocs-splash {
    position: relative;
    padding: 4rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
    min-height: 400px;
    justify-content: center;
  }

  .splash-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1200px;
    height: 100%;
    background-image: radial-gradient(
      circle at 50% 0%,
      rgba(var(--sl-color-accent-high-rgb, 100, 100, 255), 0.15) 0%,
      transparent 70%
    );
    z-index: -1;
    pointer-events: none;
  }

  .splash-content {
    max-width: 800px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  :global(.fumadocs-splash h1) {
    font-size: clamp(2.5rem, 8vw, 4.5rem) !important;
    font-weight: 800 !important;
    line-height: 1 !important;
    letter-spacing: -0.04em !important;
    margin: 0 !important;
    background: linear-gradient(to bottom right, var(--sl-color-white), var(--sl-color-gray-3));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global(.fumadocs-splash p) {
    font-size: clamp(1.125rem, 3vw, 1.25rem) !important;
    color: var(--sl-color-gray-3) !important;
    line-height: 1.5 !important;
    margin: 0 !important;
  }

  :global(.fumadocs-splash .actions) {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .fumadocs-splash {
      padding: 3rem 1rem;
    }
  }
</style>
