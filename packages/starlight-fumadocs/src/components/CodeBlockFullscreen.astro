---
/**
 * CodeBlockFullscreen.astro
 * Adds a fullscreen toggle button to all Expressive Code blocks.
 * Based on starlight-codeblock-fullscreen.
 */
---

<script is:inline>
  (function() {
    function initECFullscreen(config) {
      const {
        fullscreenButtonTooltip = "Toggle fullscreen view",
        enableEscapeKey = true,
        exitOnBrowserBack = true,
        addToUntitledBlocks = false,    
        animationDuration = 200,
        svgPathFullscreenOn = "M16 3h6v6h-2V5h-4V3zM2 3h6v2H4v4H2V3zm18 16v-4h2v6h-6v-2h4zM4 19h4v2H2v-6h2v4z",
        svgPathFullscreenOff = "M18 7h4v2h-6V3h2v4zM8 9H2V7h4V3h2v6zm10 8v4h-2v-6h6v2h-4zM8 15v6H6v-4H2v-2h6z",
      } = config;

      const CONSTANTS = {
        MIN_FONT_SIZE: 60,
        MAX_FONT_SIZE: 500,
        DEFAULT_FONT_SIZE: 100,
        FONT_ADJUSTMENT: 10,
        DOUBLE_CLICK_THRESHOLD: 600,
        HINT_DISPLAY_TIME: 4000,
        FADE_TRANSITION_TIME: 500,
        MIN_BLOCK_HEIGHT: 95,
      };

      if (window.expressiveCodeFullscreenInitialized) return;
      window.expressiveCodeFullscreenInitialized = true;

      const state = {
        isFullscreenActive: false,
        scrollPosition: 0,
        originalCodeBlock: null,
        fontSize: CONSTANTS.DEFAULT_FONT_SIZE,
      };

      const fontManager = {
        storageKey: 'expressiveCodeFullscreenFontSize',
        loadFontSize() {
          try {
            const savedSize = localStorage.getItem(this.storageKey);
            if (savedSize) {
              const parsedSize = parseInt(savedSize, 10);
              if (parsedSize >= CONSTANTS.MIN_FONT_SIZE && parsedSize <= CONSTANTS.MAX_FONT_SIZE) return parsedSize;
            }
          } catch (e) {}
          return CONSTANTS.DEFAULT_FONT_SIZE;
        },
        saveFontSize(size) {
          try { localStorage.setItem(this.storageKey, size.toString()); } catch (e) {}
        },
        applyFontSize(codeBlock) {
          if (codeBlock) {
            codeBlock.style.setProperty('--ec-font-scale', state.fontSize / 100);
          }
        },
        adjustFontSize(change, codeBlock) {
          state.fontSize = Math.max(CONSTANTS.MIN_FONT_SIZE, Math.min(CONSTANTS.MAX_FONT_SIZE, state.fontSize + change));
          this.saveFontSize(state.fontSize);
          this.applyFontSize(codeBlock);
        }
      };

      function createFullscreenContainer() {
        if (document.querySelector('.cb-fullscreen__container')) return document.querySelector('.cb-fullscreen__container');
        const container = document.createElement('div');
        container.className = 'cb-fullscreen__container';
        container.setAttribute('role', 'dialog');
        container.setAttribute('aria-modal', 'true');
        container.setAttribute('tabindex', '-1');
        container.style.setProperty('--ec-fullscreen-animation-duration', `${animationDuration}ms`);
        document.body.appendChild(container);
        return container;
      }

      function createFullscreenButton() {
        const button = document.createElement('button');
        button.className = 'cb-fullscreen__button';
        button.type = 'button';
        button.setAttribute('aria-label', fullscreenButtonTooltip);
        button.setAttribute('data-tooltip', fullscreenButtonTooltip);
        button.innerHTML = `
          <svg class="fullscreen-on" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="${svgPathFullscreenOn}" />
          </svg>
          <svg class="fullscreen-off" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="${svgPathFullscreenOff}" />
          </svg>
        `;
        return button;
      }

      function addFullscreenButtonToBlock(codeBlock) {
        if (codeBlock.querySelector('.cb-fullscreen__button')) return;
        const frame = codeBlock.querySelector('.frame');
        if (!frame) return;

        const hasTitleArea = frame.classList.contains('has-title') || frame.classList.contains('is-terminal');
        if (!addToUntitledBlocks && !hasTitleArea) return;

        // Only show if the code block has a significant number of lines (e.g. > 8)
        const lines = codeBlock.querySelectorAll('.ec-line');
        if (lines.length > 0 && lines.length <= 8) return;


        const header = codeBlock.querySelector('figcaption.header');
        const copyButton = codeBlock.querySelector(".copy");

        const toggleButton = createFullscreenButton();

        if (hasTitleArea && header) {
          // Position relative to the copy button if it exists to avoid overlap
          if (copyButton) {
            toggleButton.style.cssText = 'position: absolute; right: 3rem; top: 50%; transform: translateY(-50%); z-index: 100;';
          } else {
            toggleButton.style.cssText = 'position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); z-index: 100;';
          }
          if (getComputedStyle(header).position === 'static') header.style.position = 'relative';
          header.appendChild(toggleButton);
        } else if (copyButton) {
          if (frame.offsetHeight > CONSTANTS.MIN_BLOCK_HEIGHT) {
            const btnContainer = document.createElement("div");
            // Offset from the top to avoid overlap with copy button (which is at top: 0)
            btnContainer.style.cssText = 'position: absolute; top: 2.75rem; right: 0.5rem; z-index: 15;';
            btnContainer.appendChild(toggleButton);
            copyButton.parentNode.appendChild(btnContainer);
          }
        }
      }

      function toggleFullscreen(codeBlock) {
        const container = createFullscreenContainer();
        if (state.isFullscreenActive) exitFullscreen(container);
        else enterFullscreen(codeBlock, container);
      }

      function enterFullscreen(codeBlock, container) {
        state.originalCodeBlock = codeBlock;
        state.fontSize = fontManager.loadFontSize();
        
        const cloned = codeBlock.cloneNode(true);
        cloned.classList.add('cb-fullscreen__active');
        
        const exitBtn = cloned.querySelector('.cb-fullscreen__button');
        if (exitBtn) exitBtn.onclick = (e) => { e.stopPropagation(); toggleFullscreen(cloned); };

        state.scrollPosition = window.scrollY;
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';

        if (exitOnBrowserBack) {
          history.pushState({ fullscreenActive: true }, '', window.location.href);
          window.onpopstate = () => { if (state.isFullscreenActive) exitFullscreen(container); };
        }

        container.innerHTML = '';
        const content = document.createElement('div');
        content.className = 'cb-fullscreen__content';
        
        const controls = document.createElement('div');
        controls.className = 'cb-fullscreen__font-controls';
        controls.innerHTML = `
          <button class="cb-fullscreen__font-btn decrease" title="Zoom Out (Smaller Text)">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </button>
          <button class="cb-fullscreen__font-btn reset" title="Reset Zoom">
            <span style="font-size: 0.75rem; font-weight: bold;">100%</span>
          </button>
          <button class="cb-fullscreen__font-btn increase" title="Zoom In (Larger Text)">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </button>
        `;
        
        controls.querySelector('.decrease').onclick = () => fontManager.adjustFontSize(-CONSTANTS.FONT_ADJUSTMENT, cloned);
        controls.querySelector('.increase').onclick = () => fontManager.adjustFontSize(CONSTANTS.FONT_ADJUSTMENT, cloned);
        controls.querySelector('.reset').onclick = () => {
          state.fontSize = 100;
          fontManager.saveFontSize(100);
          fontManager.applyFontSize(cloned);
        };

        content.appendChild(controls);
        content.appendChild(cloned);
        container.appendChild(content);

        // Close on click outside content
        container.onclick = (e) => {
          if (e.target === container) exitFullscreen(container);
        };
        
        fontManager.applyFontSize(cloned);

        container.classList.add('cb-fullscreen__container--open');
        state.isFullscreenActive = true;
        container.focus();

        if (enableEscapeKey) {
          const hint = document.createElement('div');
          hint.className = 'cb-fullscreen__hint';
          hint.innerHTML = 'Press <kbd>Esc</kbd> to exit';
          container.appendChild(hint);
          setTimeout(() => hint.style.opacity = '0', CONSTANTS.HINT_DISPLAY_TIME);
        }
      }

      function exitFullscreen(container) {
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
        window.scrollTo(0, state.scrollPosition);
        container.classList.remove('cb-fullscreen__container--open');
        container.innerHTML = '';
        state.isFullscreenActive = false;
        if (exitOnBrowserBack && history.state?.fullscreenActive) history.back();
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && state.isFullscreenActive) exitFullscreen(createFullscreenContainer());
      });

      function setup() {
        document.querySelectorAll('.expressive-code').forEach(addFullscreenButtonToBlock);
        document.querySelectorAll('.cb-fullscreen__button').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const block = btn.closest('.expressive-code');
            if (block) toggleFullscreen(block);
          };
        });
      }

      setup();
      // Re-setup on page changes (for SPA navigation)
      document.addEventListener('astro:page-load', setup);
    }

    initECFullscreen({
      animationDuration: 200,
      addToUntitledBlocks: true
    });
  })();
</script>


<style is:global>
  @layer starlight, ecFullscreen;

  @layer ecFullscreen {
    .cb-fullscreen__container {
      position: fixed;
      inset: 0;
      background-color: hsla(var(--sl-color-bg-base), 0.9);
      backdrop-filter: blur(8px);
      z-index: 1000;
      overflow: auto;
      padding: 2rem;
      visibility: hidden;
      opacity: 0;
      transition: all var(--ec-fullscreen-animation-duration, 200ms) ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
    }

    .cb-fullscreen__container--open {
      visibility: visible;
      opacity: 1;
    }

    .cb-fullscreen__content {
      cursor: default;
      width: 100%;
      max-width: 80rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .expressive-code.cb-fullscreen__active {
      width: 100% !important;
      margin: 0 !important;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .expressive-code.cb-fullscreen__active pre,
    .expressive-code.cb-fullscreen__active .frame {
      font-size: calc(1em * var(--ec-font-scale, 1)) !important;
    }

    .cb-fullscreen__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      background: var(--sl-color-bg-nav);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.375rem;
      color: var(--sl-color-gray-3);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .cb-fullscreen__button:hover {
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
      transform: scale(1.05);
    }

    .cb-fullscreen__button .fullscreen-off { display: none; }
    .cb-fullscreen__active .cb-fullscreen__button .fullscreen-on { display: none; }
    .cb-fullscreen__active .cb-fullscreen__button .fullscreen-off { display: inline; }

    .cb-fullscreen__font-controls {
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
    }

    .cb-fullscreen__font-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      background: var(--sl-color-bg-nav);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.375rem;
      color: var(--sl-color-white);
      cursor: pointer;
    }

    .cb-fullscreen__hint {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0,0,0,0.8);
      color: white;
      padding: 0.5rem 1rem;
      border-radius: 2rem;
      font-size: 0.875rem;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }

    .cb-fullscreen__hint kbd {
      background: rgba(255,255,255,0.2);
      padding: 0 0.25rem;
      border-radius: 0.25rem;
    }
  }
</style>
