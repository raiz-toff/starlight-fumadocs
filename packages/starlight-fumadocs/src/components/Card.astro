---
import { Icon } from '@astrojs/starlight/components';

export interface Props {
  title: string;
  description?: string;
  icon?: string;
  href?: string;
  external?: boolean;
}

const { title, description, icon, href, external } = Astro.props;

const Wrapper = href ? 'a' : 'div';
const linkProps = href ? { href, target: external ? '_blank' : undefined, rel: external ? 'noopener noreferrer' : undefined } : {};
---

<Wrapper
  data-card
  class="fumadocs-card"
  {...linkProps}
>
  {icon && (
    <div class="card-icon-wrapper">
      <Icon name={icon as any} />
    </div>
  )}
  <h3 class="card-title">{title}</h3>
  {description && <p class="card-description">{description}</p>}
  <div class="card-content">
    <slot />
  </div>
</Wrapper>

<style>
  .fumadocs-card {
    display: block;
    border-radius: var(--fuma-radius, 8px);
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-gray-6);
    padding: 1rem;
    color: var(--sl-color-text);
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
    text-decoration: none !important;
  }

  .fumadocs-card[href]:hover {
    background-color: var(--sl-color-gray-7);
    border-color: var(--sl-color-accent);
  }

  .card-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    border-radius: 6px;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg-nav);
    padding: 0.375rem;
    color: var(--sl-color-gray-3);
  }

  .card-icon-wrapper :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .card-title {
    font-weight: 600;
    font-size: 0.875rem;
    margin: 0 !important;
    margin-bottom: 0.25rem !important;
    color: var(--sl-color-text);
  }

  .card-description {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    margin: 0 !important;
    line-height: 1.5;
  }

  .card-content {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
  }

  .card-content:empty {
    display: none;
  }
  
  .card-content :global(> *:first-child) {
    margin-top: 0;
  }
  .card-content :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
