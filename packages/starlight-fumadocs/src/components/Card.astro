---
import { Icon } from '@astrojs/starlight/components';

export interface Props {
  title: string;
  description?: string;
  icon?: string;
  href?: string;
  external?: boolean;
}

const { title, description, icon, href, external } = Astro.props;

const Wrapper = href ? 'a' : 'div';
const linkProps = href ? { href, target: external ? '_blank' : undefined, rel: external ? 'noopener noreferrer' : undefined } : {};
---

<Wrapper {...linkProps} class:list={["not-content fuma-card block no-underline rounded-xl border border-sl-color-hairline bg-sl-color-bg-sidebar p-4 transition-colors", { "fuma-card--link": href }]}>
  <div class="flex flex-col gap-2">
    {icon && (
      <div class="w-fit rounded-lg border border-sl-color-hairline bg-sl-color-gray-7 p-1.5 text-sl-color-gray-3 shadow-md">
        <Icon name={icon as any} size="1rem" />
      </div>
    )}
    <h3 class="text-sm font-medium text-sl-color-text leading-tight">
      {title}
    </h3>
    {description && <p class="text-sm text-sl-color-gray-3 leading-relaxed">{description}</p>}
    {Astro.slots.has('default') && (
      <div class="text-sl-color-gray-2 text-sm leading-relaxed mt-1">
        <slot />
      </div>
    )}
  </div>
</Wrapper>

<style is:global>
  .fuma-card p {
    margin: 0 !important;
  }
  .fuma-card--link:hover {
    background-color: var(--fuma-hover);
  }
</style>
