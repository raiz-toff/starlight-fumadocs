---
import { Icon } from '@astrojs/starlight/components';

export interface Props {
  name: string;
  icon?: string;
}

const { name, icon = 'file-text' } = Astro.props;
---

<div class="fumadocs-file">
  <Icon name={icon as any} class="file-icon" />
  <span class="file-name">{name}</span>
</div>

<style>
  .fumadocs-file {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: var(--sl-color-text);
    transition: background-color 0.2s;
  }

  .fumadocs-file:hover {
    background-color: var(--fuma-hover);
  }

  .file-icon {
    width: 1rem;
    height: 1rem;
    color: var(--sl-color-gray-3);
    flex-shrink: 0;
  }

  .file-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
