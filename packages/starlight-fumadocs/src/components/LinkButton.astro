---
import { Icon } from '@astrojs/starlight/components';

export interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'minimal' | 'outline' | 'ghost';
  icon?: string;
  external?: boolean;
}

const { href, variant = 'primary', icon, external } = Astro.props;

const isExternal = external || href.startsWith('http');
const target = isExternal ? '_blank' : undefined;
const rel = isExternal ? 'noopener noreferrer' : undefined;

const resolvedVariant = variant === 'minimal' ? 'ghost' : variant;
---

<a 
  href={href} 
  class:list={['fumadocs-link-button', `variant-${resolvedVariant}`]}
  target={target}
  rel={rel}
>
  <slot />
  {icon && <Icon name={icon as any} class="button-icon" />}
  {isExternal && !icon && <Icon name="external" class="button-icon external-icon" />}
</a>

<style>
  .fumadocs-link-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--fuma-radius, 8px);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.15s ease;
    text-decoration: none !important;
    line-height: 1.25rem;
    width: fit-content;
    cursor: pointer;
    text-decoration: none !important;
  }

  /* Primary Variant */
  .variant-primary {
    background-color: var(--sl-color-accent);
    color: var(--sl-color-text-invert) !important;
    border: 1px solid var(--sl-color-accent);
  }

  .variant-primary:hover {
    background-color: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }

  /* Secondary / Outline Variant */
  .variant-secondary,
  .variant-outline {
    background-color: transparent;
    color: var(--sl-color-text) !important;
    border: 1px solid var(--sl-color-hairline);
  }

  .variant-secondary:hover,
  .variant-outline:hover {
    background-color: var(--sl-color-gray-7);
    border-color: var(--sl-color-accent);
  }

  /* Minimal / Ghost Variant */
  .variant-minimal,
  .variant-ghost {
    background-color: transparent;
    color: var(--sl-color-text) !important;
    padding-inline: 0.5rem;
    border: 1px solid transparent;
  }

  .variant-minimal:hover,
  .variant-ghost:hover {
    background-color: var(--sl-color-gray-7);
    color: var(--sl-color-accent) !important;
  }

  .button-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .external-icon {
    opacity: 0.5;
    width: 0.875rem;
    height: 0.875rem;
  }
</style>
