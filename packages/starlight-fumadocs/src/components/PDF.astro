---
interface Props {
  src: string;
  title?: string;
  height?: string;
}

const { src, title = "PDF Document", height = "600px" } = Astro.props;
---

<div class="pdf-container not-content">
  <div class="pdf-header">
    <div class="pdf-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
      <span>{title}</span>
    </div>
    <a href={src} download class="pdf-download" title="Download PDF">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
    </a>
  </div>
  <iframe 
    src={`${src}#toolbar=0`} 
    width="100%" 
    height={height} 
    style="border: none;"
    title={title}
  >
    <p>Your browser does not support iframes. <a href={src}>View the PDF here.</a></p>
  </iframe>
</div>

<style>
  .pdf-container {
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--fuma-radius);
    overflow: hidden;
    margin: 2rem 0;
    background-color: var(--sl-color-bg-sidebar);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  .pdf-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background-color: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .pdf-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }

  .pdf-download {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-3);
    transition: all 0.2s;
    padding: 4px;
    border-radius: 4px;
  }

  .pdf-download:hover {
    color: var(--sl-color-text);
    background-color: var(--sl-color-gray-7);
  }

  iframe {
    background-color: #f1f5f9;
  }
</style>
