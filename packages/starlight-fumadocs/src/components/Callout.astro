---
import { Alert, AlertTitle, AlertDescription } from "./starwind/alert";
import { Icon } from '@astrojs/starlight/components';

export interface Props {
  /**
   * @default "info"
   */
  type?: 'info' | 'warn' | 'error' | 'success' | 'warning' | 'idea' | 'tip';
  title?: string;
  icon?: string;
}

const { type = 'info', title, icon } = Astro.props;

const resolveVariant = (type: string): "info" | "warning" | "error" | "success" | "primary" | "default" => {
  if (type === 'warn' || type === 'warning') return 'warning';
  if (type === 'error') return 'error';
  if (type === 'success') return 'success';
  if (type === 'idea') return 'primary';
  if (type === 'tip') return 'success';
  return 'info';
};

const variant = resolveVariant(type);

const iconMap: Record<string, any> = {
  info: 'information',
  warning: 'warning',
  error: 'error',
  success: 'approve-check-circle',
  primary: 'sun',
};

const iconName = icon || iconMap[variant] || 'information';
---

<Alert variant={variant} class="not-content my-5">
  <div class="flex gap-3">
    <div class={`mt-1 flex-shrink-0 text-${variant}`}>
      <Icon name={iconName} size="1.25rem" />
    </div>
    <div class="flex-1">
      {title && <AlertTitle>{title}</AlertTitle>}
      <AlertDescription>
        <slot />
      </AlertDescription>
    </div>
  </div>
</Alert>

<style is:global>
  /* Ensure standard content margins inside callout descriptions */
  [data-slot="alert-description"] p {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  [data-slot="alert-description"] *:first-child {
    margin-top: 0;
  }
  [data-slot="alert-description"] *:last-child {
    margin-bottom: 0;
  }
</style>
