---
import Search from "virtual:starlight/components/Search";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import type { Props as StarlightProps } from '@astrojs/starlight/props';
import RootNav from "./RootNav.astro";

export interface Props extends StarlightProps {}


const { sidebar } = Astro.locals.starlightRoute;
---

<!-- 1. Mobile Sidebar (Drawer) -->
<div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

<aside
  class="sidebar-mobile"
  id="sidebar-mobile"
  aria-label="Mobile navigation"
>
  <div class="sidebar-mobile-inner">
    <div class="mobile-drawer-header">
      <div class="site-title-wrapper">
        <SiteTitle {...Astro.props} />
      </div>
      <div class="mobile-actions sl-flex">
        <ThemeSelect {...Astro.props} />
        <button
          class="fuma-close-btn"
          id="fuma-mobile-close"
          aria-label="Close menu"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="root-nav-wrapper">
      <RootNav {...Astro.props} />
    </div>

    <div class="sidebar-content">
      <SidebarPersister>
        <SidebarSublist sublist={sidebar} />
      </SidebarPersister>
    </div>

    <div class="sidebar-footer mobile-only">
      <div class="footer-actions sl-flex">
        <div class="social-icons sl-flex">
          <SocialIcons {...Astro.props} />
        </div>
      </div>
    </div>
  </div>
</aside>

<!-- 2. Desktop Sidebar (Sticky Rail) -->
<aside
  class="sidebar-desktop"
  id="sidebar-desktop"
  aria-label="Desktop navigation"
>
  <div class="sidebar-desktop-inner sl-flex">
    <div class="sidebar-top">
      <div class="sidebar-header-row">
        <div class="site-title-wrapper">
          <SiteTitle {...Astro.props} />
        </div>
        <button
          class="collapse-toggle"
          id="sidebar-collapse-toggle"
          aria-label="Toggle sidebar"
          title="Collapse Sidebar"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="collapse-icon"
          >
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
          </svg>
        </button>
      </div>

      <div class="search-wrapper">
        <Search {...Astro.props} />
      </div>

      <div class="root-nav-wrapper">
        <RootNav {...Astro.props} />
      </div>
    </div>

    <div class="sidebar-content">
      <SidebarPersister>
        <SidebarSublist sublist={sidebar} />
      </SidebarPersister>
    </div>

    <div class="sidebar-footer">
      <div class="footer-actions sl-flex">
        <div class="social-icons sl-flex">
          <SocialIcons {...Astro.props} />
        </div>
        <ThemeSelect {...Astro.props} />
      </div>
    </div>
  </div>
</aside>

<style>
  /* ── SHARED STYLES ─────────────────────────────────── */
  .sidebar-content {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-hairline) transparent;
  }

  .root-nav-wrapper {
    width: 100%;
    padding: 0 0.25rem;
  }

  /* ── DESKTOP SIDEBAR (RAIL) ────────────────────────── */
  .sidebar-desktop {
    grid-area: sidebar;
    position: sticky;
    top: var(--fuma-docs-row-1, 0px);
    height: calc(var(--fuma-docs-height, 100dvh) - var(--fuma-docs-row-1, 0px));
    width: 100%;
    border-inline-end: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg-sidebar);
    overflow: hidden;
    z-index: 10;
    display: none; /* Hidden on mobile by default */
  }

  .sidebar-desktop-inner {
    width: var(--fuma-sidebar-width, 268px);
    height: 100%;
    flex-direction: column;
    padding: 0;
    margin-inline-start: auto; /* Align to the right of its grid cell */
  }

  .sidebar-top {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 1rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .sidebar-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .collapse-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--fuma-radius);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .collapse-toggle:hover {
    color: var(--sl-color-text);
    background-color: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
  }

  .sidebar-footer {
    padding: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg);
  }

  .sidebar-footer.mobile-only {
    display: block;
    margin-top: auto;
  }

  .footer-actions {
    justify-content: space-between;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .sidebar-desktop {
      display: block;
    }
  }

  /* ── MOBILE SIDEBAR (DRAWER) ───────────────────────── */
  .sidebar-mobile {
    display: none;
    position: fixed;
    top: 0;
    inset-inline-end: 0;
    inset-inline-start: auto;
    width: min(268px, 80vw);
    height: 100dvh;
    background-color: var(--sl-color-bg-sidebar);
    z-index: 100;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  @media (max-width: 1023px) {
    .sidebar-mobile {
      display: block;
    }
  }

  .sidebar-mobile-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    gap: 1rem;
  }

  .site-title-wrapper {
    flex: 1;
    min-width: 0;
    /* Ensure title truncates if too long */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .fuma-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--fuma-radius);
    color: var(--sl-color-text);
    cursor: pointer;
    flex-shrink: 0; /* Never shrink the close button */
    transition: background-color 0.2s;
  }

  .fuma-close-btn:hover {
    background-color: var(--sl-color-gray-5);
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 99;
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .sidebar-overlay {
      display: block;
    }
  }

  /* ── STATE LOGIC ───────────────────────────────────── */
  :global(body[data-mobile-menu-expanded]) .sidebar-mobile {
    transform: translateX(0);
  }
  :global(body[data-mobile-menu-expanded]) .sidebar-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* Collapsed State (Only applies to desktop rail) */
  @media (min-width: 768px) {
    :global([data-sidebar-collapsed="true"])
      .sidebar-desktop-inner
      .site-title-wrapper,
    :global([data-sidebar-collapsed="true"])
      .sidebar-desktop-inner
      .root-nav-wrapper,
    :global([data-sidebar-collapsed="true"])
      .sidebar-desktop-inner
      .sidebar-content,
    :global([data-sidebar-collapsed="true"])
      .sidebar-desktop-inner
      .sidebar-footer {
      display: none !important;
    }

    :global([data-sidebar-collapsed="true"])
      .sidebar-desktop-inner
      .sidebar-header-row {
      justify-content: center;
    }

    /* Collapsed Search Button Styling */
    :global([data-sidebar-collapsed="true"]) .search-wrapper :global(button) {
      width: 32px !important;
      height: 32px !important;
      padding: 0 !important;
      border: 1px solid var(--sl-color-hairline) !important;
      border-radius: var(--fuma-radius, 8px) !important;
      background-color: transparent !important;
      color: var(--sl-color-gray-2) !important;
      display: flex !important;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      margin: 0 auto;
    }

    :global([data-sidebar-collapsed="true"]) .search-wrapper :global(button:hover) {
      color: var(--sl-color-text) !important;
      background-color: var(--sl-color-gray-6) !important;
      border-color: var(--sl-color-gray-4) !important;
    }

    /* Hide Search text/shortcut in collapsed rail */
    :global([data-sidebar-collapsed="true"]) .search-wrapper :global(.sl-hidden),
    :global([data-sidebar-collapsed="true"]) .search-wrapper :global(kbd) {
      display: none !important;
    }
  }

  /* ── NAV TREE STYLES (RE-APPLIED) ──────────────────── */
  :global(.sidebar-content ul) {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  :global(.sidebar-content a) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--fuma-radius);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition:
      background 0.15s,
      color 0.15s;
  }
  :global(.sidebar-content a:hover) {
    background: var(--sl-color-gray-7);
    color: var(--sl-color-text);
  }
  :global(.sidebar-content a[aria-current="page"]) {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    font-weight: 500;
  }
  :global(.sidebar-content summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-text);
    cursor: pointer;
    list-style: none;
  }
</style>

<script>
  // Mobile drawer close logic
  const overlay = document.getElementById("sidebar-overlay");
  const closeBtn = document.getElementById("fuma-mobile-close");
  const close = () => {
    // Corrected selector: Starlight tracks the expanded state on the <starlight-menu-button> custom element itself.
    const menuButtonEl = document.querySelector(
      'starlight-menu-button[aria-expanded="true"]',
    );
    if (menuButtonEl) {
      const btn = menuButtonEl.querySelector("button");
      if (btn) {
        // Clicking the internal button triggers Starlight's logic to close the menu and reset the icon.
        btn.click();
        return;
      }
    }
    // Fallback if the Starlight component is not found or already closed
    document.body.removeAttribute("data-mobile-menu-expanded");
  };

  overlay?.addEventListener("click", close);
  closeBtn?.addEventListener("click", close);

  // Desktop collapse logic
  const layout = document.querySelector(".fumadocs-layout");
  const toggle = document.getElementById("sidebar-collapse-toggle");
  const STORAGE_KEY = "fuma-sidebar-collapsed";

  if (layout && toggle) {
    const isDesktop = () => window.innerWidth >= 768;

    // Initialize state
    if (isDesktop() && localStorage.getItem(STORAGE_KEY) === "true") {
      layout.setAttribute("data-sidebar-collapsed", "true");
    }

    toggle.addEventListener("click", () => {
      const isCollapsed =
        layout.getAttribute("data-sidebar-collapsed") === "true";
      layout.setAttribute("data-sidebar-collapsed", String(!isCollapsed));
      localStorage.setItem(STORAGE_KEY, String(!isCollapsed));
    });

    // Handle breakpoint transitions
    const mql = window.matchMedia("(min-width: 768px)");
    mql.addEventListener("change", (e) => {
      if (e.matches) {
        // Entering Desktop: restore collapsed state if needed
        if (localStorage.getItem(STORAGE_KEY) === "true") {
          layout.setAttribute("data-sidebar-collapsed", "true");
        }
      } else {
        // Entering Mobile: completely remove collapse attribute and close drawer
        layout.removeAttribute("data-sidebar-collapsed");
        close();
      }
    });
  }
</script>
