---
import Search from "virtual:starlight/components/Search";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import type { Props as StarlightProps } from "@astrojs/starlight/props";
import RootNav from "./RootNav.astro";

export interface Props extends StarlightProps {}

const { sidebar } = Astro.locals.starlightRoute;
---

<!-- 1. Mobile Sidebar (Drawer) -->
<div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

<aside
  class="sidebar-mobile"
  id="sidebar-mobile"
  aria-label="Mobile navigation"
>
  <div class="sidebar-mobile-inner">
    <div class="mobile-drawer-header">
      <div class="site-title-wrapper">
        <SiteTitle {...Astro.props} />
      </div>
      <div class="mobile-actions sl-flex">
        <ThemeSelect {...Astro.props} />
        <button
          class="fuma-close-btn"
          id="fuma-mobile-close"
          aria-label="Close menu"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="root-nav-wrapper">
      <RootNav {...Astro.props} />
    </div>

    <div class="sidebar-content">
      <SidebarPersister>
        <SidebarSublist sublist={sidebar} />
      </SidebarPersister>
    </div>

    <div class="sidebar-footer mobile-only">
      <div class="footer-actions sl-flex">
        <div class="social-icons sl-flex">
          <SocialIcons {...Astro.props} />
        </div>
      </div>
    </div>
  </div>
</aside>

<!-- 2. Desktop Sidebar (Sticky Rail) -->
<aside
  class="sidebar-desktop"
  id="starlight-fumadocs-sidebar"
  aria-label="Desktop navigation"
>
  <div class="sidebar-desktop-inner sl-flex">
    <div class="sidebar-top">
      <div class="sidebar-header-row">
        <div class="site-title-wrapper">
          <SiteTitle {...Astro.props} />
        </div>
        <button
          class="collapse-toggle"
          id="sidebar-collapse-toggle"
          aria-label="Toggle sidebar"
          title="Collapse Sidebar"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="collapse-icon"
          >
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
          </svg>
        </button>
      </div>

      <div class="search-wrapper">
        <Search {...Astro.props} />
      </div>

      <div class="root-nav-wrapper">
        <RootNav {...Astro.props} />
      </div>
    </div>

    <div class="sidebar-content">
      <SidebarPersister>
        <SidebarSublist sublist={sidebar} />
      </SidebarPersister>
    </div>

    <div class="sidebar-footer">
      <div class="footer-actions sl-flex">
        <div class="social-icons sl-flex">
          <SocialIcons {...Astro.props} />
        </div>
        <ThemeSelect {...Astro.props} />
      </div>
    </div>
  </div>
</aside>

<!-- 3. Collapsed-rail affordances (siblings of the aside so the aside's
     transform doesn't trap these fixed elements) -->
<div class="sidebar-hover-zone" aria-hidden="true"></div>
<button
  class="sidebar-float-toggle"
  id="sidebar-float-toggle"
  aria-label="Expand sidebar"
  title="Expand Sidebar"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect width="18" height="18" x="3" y="3" rx="2"></rect>
    <path d="M9 3v18"></path>
  </svg>
</button>

<style>
  /* ── SHARED STYLES ─────────────────────────────────── */
  .sidebar-content {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-hairline) transparent;
  }

  .root-nav-wrapper {
    width: 100%;
    padding: 0;
    margin-top: 0.5rem;
  }

  /* ── DESKTOP SIDEBAR (RAIL) ────────────────────────── */
  .sidebar-desktop {
    grid-area: sidebar;
    position: sticky;
    top: var(--fuma-docs-row-1, 0px);
    height: calc(var(--fuma-docs-height, 100dvh) - var(--fuma-docs-row-1, 0px));
    width: 100%;
    border-inline-end: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg-sidebar);
    overflow: hidden;
    z-index: 10;
    display: none; /* Hidden on mobile by default */
  }

  .sidebar-desktop-inner {
    width: var(--fuma-sidebar-width, 312px);
    height: 100%;
    flex-direction: column;
    padding: 0;
    margin-inline-start: auto; /* Align to the right of its grid cell */
  }

  .sidebar-top {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem 0 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .search-wrapper,
  .root-nav-wrapper {
    padding: 0 1.25rem;
  }

  .sidebar-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 1.25rem;
  }

  .collapse-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--fuma-radius);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .collapse-toggle:hover {
    color: var(--sl-color-text);
    background-color: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
  }

  .sidebar-footer {
    padding: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg);
  }

  .sidebar-footer.mobile-only {
    display: block;
    margin-top: auto;
  }

  .footer-actions {
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .social-icons {
    gap: 0.25rem;
  }

  .social-icons :global(a) {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 2rem !important;
    height: 2rem !important;
    padding: 0 !important;
    color: var(--sl-color-gray-3) !important;
    transition: all 0.2s ease;
    border-radius: var(--fuma-radius);
  }

  .social-icons :global(a:hover) {
    color: var(--sl-color-text) !important;
    background-color: var(--sl-color-gray-6);
  }

  .social-icons :global(svg) {
    width: 1.25rem !important;
    height: 1.25rem !important;
  }

  @media (min-width: 768px) {
    .sidebar-desktop {
      display: block;
    }
  }

  /* ── MOBILE SIDEBAR (DRAWER) ───────────────────────── */
  .sidebar-mobile {
    display: none;
    position: fixed;
    top: 0;
    inset-inline-end: 0;
    inset-inline-start: auto;
    width: min(380px, 90vw);
    height: 100dvh;
    background-color: var(--sl-color-bg-sidebar);
    z-index: 100;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  @media (max-width: 767px) {
    .sidebar-mobile {
      display: block;
    }
  }

  .sidebar-mobile-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    gap: 1rem;
  }

  .site-title-wrapper {
    flex: 1;
    min-width: 0;
    /* Ensure title truncates if too long */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .fuma-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--fuma-radius);
    color: var(--sl-color-text);
    cursor: pointer;
    flex-shrink: 0; /* Never shrink the close button */
    transition: background-color 0.2s;
  }

  .fuma-close-btn:hover {
    background-color: var(--sl-color-gray-5);
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: var(--sl-color-overlay, hsla(0, 0%, 0%, 0.2));
    z-index: 99;
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .sidebar-overlay {
      display: block;
    }
  }

  /* ── STATE LOGIC ───────────────────────────────────── */
  :global(body[data-mobile-menu-expanded]) .sidebar-mobile {
    transform: translateX(0);
  }
  :global(body[data-mobile-menu-expanded]) .sidebar-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── COLLAPSED RAIL: off-screen slide + hover reveal ──── */
  /* Hidden until the sidebar is collapsed */
  .sidebar-hover-zone,
  .sidebar-float-toggle {
    display: none;
  }

  @media (min-width: 768px) {
    /* The rail detaches into a floating card and slides off-screen. When the
       user peeks (edge hover) it slides back in as a detached panel. */
    :global([data-sidebar-collapsed="true"]) .sidebar-desktop {
      position: fixed;
      inset-block: 0.75rem;
      inset-inline-start: 0.75rem;
      width: 268px;
      height: auto;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
      overflow: hidden;
      transform: translateX(calc(-100% - 1.5rem));
      transition: transform 0.25s ease;
      z-index: 40;
    }

    /* Inner fills the floating card (its width is otherwise driven by
       --fuma-sidebar-width, which is 0 when collapsed) */
    :global([data-sidebar-collapsed="true"]) .sidebar-desktop-inner {
      width: 100% !important;
      margin-inline-start: 0;
    }

    /* Reveal on peek (hover zone / rail hover — toggled in JS) */
    :global([data-sidebar-collapsed="true"].sidebar-peek) .sidebar-desktop {
      transform: translateX(0);
    }

    /* Thin strip at the viewport's inline-start edge that triggers the peek */
    :global([data-sidebar-collapsed="true"]) .sidebar-hover-zone {
      display: block;
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      width: 12px;
      z-index: 39;
    }

    /* Floating expand button, bottom inline-start */
    :global([data-sidebar-collapsed="true"]) .sidebar-float-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      inset-inline-start: 1rem;
      inset-block-start: calc(var(--fuma-banner-height, 0px) + 0.75rem);
      width: 36px;
      height: 36px;
      z-index: 41;
      border: 1px solid var(--sl-color-hairline);
      border-radius: var(--fuma-radius);
      background-color: var(--sl-color-bg-sidebar);
      color: var(--sl-color-gray-2);
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: opacity 0.2s ease, color 0.2s ease,
        background-color 0.2s ease, border-color 0.2s ease;
    }

    :global([data-sidebar-collapsed="true"]) .sidebar-float-toggle:hover {
      color: var(--sl-color-text);
      background-color: var(--sl-color-gray-6);
      border-color: var(--sl-color-gray-4);
    }

    /* While peeked, the rail's own collapse toggle is visible — hide the float button */
    :global([data-sidebar-collapsed="true"].sidebar-peek) .sidebar-float-toggle {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* ── NAV TREE STYLES (RE-APPLIED) ──────────────────── */
  :global(.sidebar-content ul) {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  :global(.sidebar-content a) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.45rem 0.875rem;
    border-radius: var(--fuma-radius);
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition:
      background 0.15s,
      color 0.15s;
  }
  :global(.sidebar-content a:hover) {
    background: var(--sl-color-gray-7);
    color: var(--sl-color-text);
  }
  :global(.sidebar-content a[aria-current="page"]) {
    background: color-mix(in oklab, var(--sl-color-accent) 12%, transparent);
    color: var(--sl-color-text-accent);
    font-weight: 500;
  }

  /* ── Sidebar Hierarchy Connectors ─────────────────── */
  :global(.sidebar-content ul ul) {
    margin-inline-start: 1rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }

  :global(.sidebar-content li) {
    position: relative;
  }

  /* Active Indicator Segment */
  :global(.sidebar-content a[aria-current="page"]::before) {
    content: "";
    position: absolute;
    left: -0.55rem; /* Aligns with the border-inline-start of the parent ul */
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    background-color: var(--sl-color-accent);
    border-radius: 1px;
    z-index: 1;
  }
  :global(.sidebar-content summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-text);
    cursor: pointer;
    list-style: none;
  }
</style>

<script>
  const initSidebar = () => {
    // Mobile drawer close logic
    const overlay = document.getElementById("sidebar-overlay");
    const closeBtn = document.getElementById("fuma-mobile-close");
    const close = () => {
      const menuButtonEl = document.querySelector(
        'starlight-menu-button[aria-expanded="true"]',
      );
      if (menuButtonEl) {
        const btn = menuButtonEl.querySelector("button");
        if (btn) {
          btn.click();
          return;
        }
      }
      document.body.removeAttribute("data-mobile-menu-expanded");
    };

    overlay?.addEventListener("click", close);
    closeBtn?.addEventListener("click", close);

    // Desktop collapse logic
    const layout = document.querySelector(".fumadocs-layout");
    const toggle = document.getElementById("sidebar-collapse-toggle");
    const STORAGE_KEY = "fuma-sidebar-collapsed";

    if (layout && toggle) {
      const isDesktop = () => window.innerWidth >= 768;

      if (isDesktop() && localStorage.getItem(STORAGE_KEY) === "true") {
        layout.setAttribute("data-sidebar-collapsed", "true");
      }

      // ── Peek (hover-reveal) behaviour for the collapsed rail ──
      const sidebarEl = document.getElementById("starlight-fumadocs-sidebar");
      const hoverZone = document.querySelector(".sidebar-hover-zone");
      const floatToggle = document.getElementById("sidebar-float-toggle");
      const isCollapsed = () =>
        layout.getAttribute("data-sidebar-collapsed") === "true";
      const addPeek = () => {
        if (isCollapsed()) layout.classList.add("sidebar-peek");
      };
      const removePeek = () => layout.classList.remove("sidebar-peek");

      hoverZone?.addEventListener("mouseenter", addPeek);
      sidebarEl?.addEventListener("mouseenter", addPeek);
      sidebarEl?.addEventListener("mouseleave", removePeek);

      const setCollapsed = (value: boolean) => {
        layout.setAttribute("data-sidebar-collapsed", String(value));
        localStorage.setItem(STORAGE_KEY, String(value));
        removePeek();
      };

      toggle.addEventListener("click", () => setCollapsed(!isCollapsed()));
      floatToggle?.addEventListener("click", () => setCollapsed(false));

      const mql = window.matchMedia("(min-width: 768px)");
      mql.addEventListener("change", (e) => {
        if (e.matches) {
          if (localStorage.getItem(STORAGE_KEY) === "true") {
            layout.setAttribute("data-sidebar-collapsed", "true");
          }
        } else {
          layout.removeAttribute("data-sidebar-collapsed");
          removePeek();
          close();
        }
      });
    }
  };

  // Run on initial load and on every page navigation
  initSidebar();
  document.addEventListener("astro:page-load", initSidebar);
</script>
