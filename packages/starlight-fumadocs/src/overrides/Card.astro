---
import { Icon } from "@astrojs/starlight/components";

interface Props {
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;
---

<div
  class="fuma-card not-content animate my-4 h-full p-5 border border-sl-color-hairline rounded-lg bg-sl-color-bg-sidebar shadow-sm transition-all hover:shadow-md hover:-translate-y-1"
>
  <div class="flex flex-col gap-3">
    {
      icon && (
        <div class="flex size-10 items-center justify-center rounded-lg border border-sl-color-hairline bg-sl-color-bg text-sl-color-accent shadow-sm">
          <Icon name={icon as any} size="1.25rem" />
        </div>
      )
    }
    <h3 class="text-lg font-semibold text-sl-color-text leading-tight">
      {title}
    </h3>
    <div class="text-sl-color-gray-3 text-sm leading-relaxed">
      <slot />
    </div>
  </div>
</div>

<style>
  .fuma-card {
    /* Ensure it works well with the grid or flex containers */
    display: flex;
    flex-direction: column;
  }
</style>
