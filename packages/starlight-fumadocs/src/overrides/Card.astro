---
import { Icon } from "@astrojs/starlight/components";

interface Props {
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;
---

<div
  class="fuma-card not-content my-4 rounded-xl border border-sl-color-hairline bg-sl-color-bg-sidebar p-4 transition-colors"
>
  <div class="flex flex-col gap-2">
    {
      icon && (
        <div class="w-fit rounded-lg border border-sl-color-hairline bg-sl-color-gray-7 p-1.5 text-sl-color-gray-3 shadow-md">
          <Icon name={icon as any} size="1rem" />
        </div>
      )
    }
    <h3 class="text-sm font-medium text-sl-color-text leading-tight">
      {title}
    </h3>
    <div class="text-sl-color-gray-3 text-sm leading-relaxed">
      <slot />
    </div>
  </div>
</div>

<style>
  .fuma-card {
    /* Ensure it works well with the grid or flex containers */
    display: flex;
    flex-direction: column;
  }
</style>
