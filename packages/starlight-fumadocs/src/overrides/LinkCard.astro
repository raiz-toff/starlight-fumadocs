---
interface Props {
	title: string;
	description?: string;
	href: string;
}

const { title, description, href, ...rest } = Astro.props;
---

<a href={href} class="fuma-link-card not-content no-underline block my-4 rounded-xl border border-sl-color-hairline bg-sl-color-bg-sidebar p-4 transition-colors" {...rest}>
  <div class="flex flex-col gap-1">
    <h3 class="text-sm font-medium text-sl-color-text leading-tight">
      {title}
    </h3>
    {description && <p class="text-sm text-sl-color-gray-3 leading-relaxed">{description}</p>}
  </div>
</a>

<style>
  .fuma-link-card {
    text-decoration: none !important;
  }
  .fuma-link-card:hover {
    background-color: var(--fuma-hover);
  }
</style>
