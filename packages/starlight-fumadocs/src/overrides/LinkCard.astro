---
import { Icon } from "@astrojs/starlight/components";

interface Props {
	title: string;
	description?: string;
	href: string;
}

const { title, description, href, ...rest } = Astro.props;
---

<a href={href} class="fuma-link-card not-content group no-underline block animate my-4 transition-all" {...rest}>
  <div class="h-full p-5 border border-sl-color-hairline rounded-lg bg-sl-color-bg-sidebar shadow-sm group-hover:border-sl-color-accent/50 group-hover:shadow-md group-hover:-translate-y-1 transition-all">
    <div class="flex flex-col gap-2">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-sl-color-text group-hover:text-sl-color-accent transition-colors leading-tight">
          {title}
        </h3>
        <Icon name="right-arrow" size="1.25rem" class="text-sl-color-gray-3 group-hover:text-sl-color-accent transition-colors" />
      </div>
      {description && <p class="text-sm text-sl-color-gray-3 leading-relaxed">{description}</p>}
    </div>
  </div>
</a>

<style>
  .fuma-link-card {
    text-decoration: none !important;
  }
</style>
