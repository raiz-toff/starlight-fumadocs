---
import TableOfContentsList from './TableOfContentsList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
	toc && (
		<starlight-toc class="fuma-toc" data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page">
				<h2 id="starlight__on-this-page">{Astro.locals.t('tableOfContents.onThisPage')}</h2>
				<div class="toc-list">
					<TableOfContentsList toc={toc.items} />
				</div>
			</nav>
		</starlight-toc>
	)
}

<script src="./starlight-toc.ts"></script>

<style>
	.fuma-toc nav {
		position: static;
	}

	.fuma-toc h2 {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		margin: 0 0 0.75rem;
	}

	/* TOC List Wrapper */
	.toc-list {
		border-inline-start: 1px solid var(--sl-color-hairline);
	}

	.fuma-toc :global(ul) {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.fuma-toc :global(li) {
		margin: 0;
	}

	/* TOC links */
	.fuma-toc :global(a) {
		display: block;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		padding: 0.25rem 0.875rem;
		transition: color 0.15s ease;
		overflow-wrap: anywhere;
		position: relative;
	}

	.fuma-toc :global(a:hover) {
		color: var(--sl-color-text);
	}

	/* Active TOC link — with Fumadocs-style rail indicator */
	.fuma-toc :global(a[aria-current='true']) {
		color: var(--sl-color-text);
		font-weight: 500;
	}

	.fuma-toc :global(a[aria-current='true'])::before {
		content: '';
		position: absolute;
		inset-inline-start: -1px;
		top: 0.25rem;
		bottom: 0.25rem;
		width: 1px;
		background-color: var(--sl-color-accent);
	}

	/* Nested TOC levels */
	.fuma-toc :global(ul ul) {
		padding-inline-start: 0.875rem;
	}
</style>
