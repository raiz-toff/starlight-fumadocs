---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import type { Props as StarlightProps } from '@astrojs/starlight/props';

export interface Props extends StarlightProps {}

const { hasSidebar: propHasSidebar, entry: propEntry } = Astro.props;
const route = Astro.locals.starlightRoute;
const entry = propEntry || route?.entry;
const hasSidebar = propHasSidebar ?? route?.hasSidebar;

const isSplash = entry?.data.template === 'splash' || !!entry?.data.hero || hasSidebar === false;
---

<header class="header">
	<div class={`header-container sl-flex ${isSplash ? 'is-splash' : ''}`}>
		<div class="title-wrapper sl-flex">
			<SiteTitle {...Astro.props} />
		</div>
		<div class="sl-flex print:hidden right-group">
			<div class="search-wrapper">
				<Search {...Astro.props} />
			</div>
			{isSplash ? (
				<div class="theme-select-wrapper">
					<ThemeSelect {...Astro.props} />
				</div>
			) : (
				<div class="hamburger-wrapper">
					<MobileMenuToggle {...Astro.props} />
				</div>
			)}
		</div>
	</div>
</header>

<style>
	.header {
		grid-area: header;
		position: sticky;
		top: var(--fuma-banner-height, 0);
		z-index: 50;
		border-bottom: 1px solid var(--sl-color-hairline);
		background-color: hsla(var(--sl-color-bg-nav-base), 0.7);
		backdrop-filter: blur(12px);
		height: var(--fuma-header-height);
		overflow: hidden; /* Collapse when height is 0 */
		transition: height 0.3s ease;
	}

	.header-container {
		padding-inline: var(--sl-nav-pad-x);
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 100%;
		max-width: var(--fuma-layout-width);
		margin: 0 auto;
	}

	.title-wrapper {
		min-width: 0;
		flex-shrink: 1;
	}

	.right-group {
		gap: 0.5rem;
		align-items: center;
		flex-shrink: 0;
	}

	.theme-select-wrapper,
	.hamburger-wrapper {
		display: flex;
		align-items: center;
		height: 100%;
	}

	/* Common Button Styling for Mobile Toggle and Theme Select */
	.hamburger-wrapper :global(starlight-menu-button button),
	.theme-select-wrapper :global(starlight-theme-select select) {
		display: flex !important;
		align-items: center;
		justify-content: center;
		width: 32px !important;
		height: 32px !important;
		padding: 0 !important;
		border: 1px solid var(--sl-color-hairline) !important;
		border-radius: var(--fuma-radius, 8px) !important;
		background-color: var(--sl-color-gray-6) !important;
		color: var(--sl-color-text) !important;
		cursor: pointer;
		transition: all 0.2s ease;
		box-sizing: border-box !important;
		margin: 0 !important;
	}

	.theme-select-wrapper :global(starlight-theme-select label) {
		display: none !important;
	}

	.theme-select-wrapper :global(starlight-theme-select select) {
		padding-inline: 0.5rem !important;
		font-size: 0.75rem !important;
		width: 48px !important;
		background-color: var(--sl-color-gray-6) !important;
		border: 1px solid var(--sl-color-hairline) !important;
		border-radius: var(--fuma-radius, 8px) !important;
		color: var(--sl-color-text) !important;
		appearance: none !important;
		text-align: center !important;
	}

	.hamburger-wrapper :global(starlight-menu-button) {
		display: contents !important; /* Neutralize the custom element wrapper */
	}

	.hamburger-wrapper :global(button:hover),
	.theme-select-wrapper :global(select:hover) {
		background-color: var(--sl-color-gray-5) !important;
		border-color: var(--sl-color-gray-4) !important;
	}

	/* Header search: compact icon-only button */
	.search-wrapper :global(.search-trigger) {
		width: auto !important;
		max-width: none !important;
	}

	.search-wrapper :global(.trigger-gooey-wrap) {
		filter: none !important;
	}

	.search-wrapper :global(.trigger-pill) {
		width: 32px !important;
		height: 32px !important;
		padding: 0 !important;
		justify-content: center !important;
		border: 1px solid var(--sl-color-hairline) !important;
		border-radius: var(--fuma-radius, 8px) !important;
		background-color: var(--sl-color-gray-6) !important;
		color: var(--sl-color-text) !important;
	}

	.search-wrapper :global(.trigger-pill:hover) {
		background-color: var(--sl-color-gray-5) !important;
		border-color: var(--sl-color-gray-4) !important;
	}

	.search-wrapper :global(.trigger-label),
	.search-wrapper :global(.trigger-shortcut) {
		display: none !important;
	}

	.search-wrapper :global(.search-icon) {
		opacity: 0.8 !important;
	}

	/* Hide Header on Desktop only when Sidebar Rail is present — 
	   FumaDocs shows header on Hero/Splash pages without sidebars */
	@media (min-width: 1024px) {
		:global(.fumadocs-layout[data-has-sidebar="true"]) .header {
			display: none;
		}
	}
</style>
