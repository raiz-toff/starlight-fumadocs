---
import { Icon } from '@astrojs/starlight/components';
import Breadcrumb from './Breadcrumb.astro';

const { entry } = Astro.locals.starlightRoute;
---

<div class="page-title-block">
  <Breadcrumb />
  
  <h1 id="_top">{entry.data.title}</h1>
  
  {entry.data.description && (
    <p class="description">{entry.data.description}</p>
  )}

  <div class="page-actions sl-flex">
    <button id="copy-markdown-btn" class="action-btn sl-flex" aria-label="Copy Markdown">
      <Icon name="document" size="1rem" />
      <span class="label">Copy Markdown</span>
    </button>
    {Astro.props.editUrl && (
      <a href={Astro.props.editUrl} class="action-btn sl-flex" style="text-decoration: none;" target="_blank" rel="noopener noreferrer">
        <Icon name="external" size="1rem" />
        <span>Open</span>
      </a>
    )}
  </div>
</div>

<script is:inline src="https://unpkg.com/turndown/dist/turndown.js"></script>
<script is:inline>
  (function() {
    function setupCopyMarkdown() {
      const copyBtn = document.getElementById('copy-markdown-btn');
      const label = copyBtn?.querySelector('.label');

      if (copyBtn && label && window.TurndownService) {
        const turndownService = new window.TurndownService({
          headingStyle: 'atx',
          codeBlockStyle: 'fenced',
        });

        copyBtn.onclick = async () => {
          const content = document.querySelector('main .sl-markdown-content');
          if (!content) return;

          const clone = content.cloneNode(true);
          clone.querySelectorAll('.sl-anchor-link, .copy, script, style, .cb-fullscreen__button').forEach(el => el.remove());

          const markdown = turndownService.turndown(clone);
          const title = document.querySelector('h1')?.textContent || '';
          const fullMarkdown = `# ${title}\n\n${markdown}`;

          try {
            await navigator.clipboard.writeText(fullMarkdown);
            const originalText = label.textContent;
            label.textContent = 'Copied!';
            
            setTimeout(() => {
              label.textContent = originalText;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy: ', err);
          }
        };
      }
    }

    setupCopyMarkdown();
    document.addEventListener('astro:page-load', setupCopyMarkdown);
  })();
</script>



<style>
  .page-title-block {
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1.125rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
    line-height: 1.5;
  }

  .page-actions {
    margin-top: 1.5rem;
    gap: 0.5rem;
    align-items: center;
  }

  .action-btn {
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem; /* 6px */
    background-color: var(--sl-color-bg-sidebar);
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background-color: var(--sl-color-gray-7);
    color: var(--sl-color-text);
  }

  .action-btn :global(svg) {
    color: var(--sl-color-gray-3);
    transition: color 0.2s ease;
  }

  .action-btn:hover :global(svg) {
    color: var(--sl-color-text);
  }
</style>
