---
const { banner } = Astro.locals.starlightRoute.entry.data;
const content = banner ? (banner as any).content : '';
---

{
  banner && (
    <>
      <style is:global>
        :root {
          --fuma-banner-height: 3rem;
        }
      </style>
      <div class="fumadocs-banner not-prose" data-banner>
        <div class="banner-content" set:html={content} />
        <button type="button" class="banner-close" aria-label="Dismiss banner" data-banner-close>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <script>
        const el = document.querySelector('[data-banner]') as HTMLElement | null;
        if (el) {
          const text = el.textContent || '';
          let hash = 0;
          for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) | 0;
          const key = 'fuma-banner-' + hash;
          const dismiss = () => {
            el.style.display = 'none';
            document.documentElement.style.setProperty('--fuma-banner-height', '0px');
          };
          if (localStorage.getItem(key)) dismiss();
          el.querySelector('[data-banner-close]')?.addEventListener('click', () => {
            localStorage.setItem(key, '1');
            dismiss();
          });
        }
      </script>
    </>
  )
}

<style>
  .fumadocs-banner {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3rem; /* fd-banner-height */
    padding-inline: 2.5rem;
    background-color: var(--sl-color-bg-inline-code); /* bg-fd-secondary */
    font-size: 0.875rem;
    font-weight: 500;
    overflow: hidden;
  }

  .banner-content {
    color: var(--sl-color-text);
  }

  :global(.banner-content a) {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .banner-close {
    position: absolute;
    inset-inline-end: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--fuma-radius);
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .banner-close:hover {
    color: var(--sl-color-text);
    background-color: var(--fuma-hover);
  }
</style>
