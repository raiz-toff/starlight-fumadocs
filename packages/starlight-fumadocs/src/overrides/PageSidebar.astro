---
import type { Props as StarlightProps } from '@astrojs/starlight/props';

export interface Props extends StarlightProps {}

import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';

const { toc } = Astro.locals.starlightRoute;
---

{toc && (
	<>
		{/* Mobile/tablet TOC popover bar — grid-area: toc-popover, handled in MobileTableOfContents */}
		<div class="toc-popover-wrapper">
			<MobileTableOfContents {...Astro.props} />
		</div>

		{/* Desktop TOC right rail — grid-area: toc, sticky, visible only at desktop widths */}
		<aside class="toc-rail" aria-label="Table of contents">
			<div class="toc-rail-inner">
				<TableOfContents {...Astro.props} />
			</div>
		</aside>
	</>
)}

<style>
	/* ── TOC Popover wrapper (tablet + mobile) ─────────── */
	.toc-popover-wrapper {
		grid-area: toc-popover;
		display: contents;
	}

	/* Hide TOC popover on desktop (≥1280px per FumaDocs XL spec) */
	@media (min-width: 1280px) {
		.toc-popover-wrapper {
			display: none;
		}
	}

	/* ── Desktop TOC Rail ──────────────────────────────── */
	.toc-rail {
		display: none; /* Hidden by default (mobile/tablet) */
	}

	@media (min-width: 1280px) {
		.toc-rail {
			display: flex;
			justify-content: flex-start;
			grid-area: toc;
			position: sticky;
			/* Per plan: TOC rail top = --fuma-docs-row-2 (banner + header height).
			   On desktop header is 0px so row-2 = 0px, but using the var is
			   correct and future-proof for banners. */
			top: var(--fuma-docs-row-2, 0px);
			height: calc(var(--fuma-docs-height, 100dvh) - var(--fuma-docs-row-2, 0px));
			width: 100%;
			background-color: var(--sl-color-bg);
			overflow: hidden;
			flex-shrink: 0;
		}
	}

	.toc-rail-inner {
		width: var(--fuma-toc-width, 268px);
		height: 100%;
		overflow-y: auto;
		padding: 3rem 1rem 0.5rem;
		scrollbar-width: thin;
		scrollbar-color: var(--sl-color-hairline) transparent;
	}
</style>
