---
import { Icon } from "@astrojs/starlight/components";

interface Props {
	type?: "note" | "tip" | "caution" | "danger";
	title?: string;
}

const { type = "note", title } = Astro.props;

const variantMap = {
	note: "info",
	tip: "success",
	caution: "warning",
	danger: "error",
} as const;

const iconMap = {
	note: "information",
	tip: "rocket",
	caution: "warning",
	danger: "error",
} as const;

const variant = variantMap[type];
const iconName = iconMap[type];

// Use the title from props or the capitalized type as a fallback
const displayTitle = title || type.charAt(0).toUpperCase() + type.slice(1);

// Map variants to the Fumadocs static accent color
const accentMap = {
  info: "var(--fuma-color-info)",
  success: "var(--fuma-color-success)",
  warning: "var(--fuma-color-warning)",
  error: "var(--fuma-color-error)",
};
const accent = accentMap[variant];
---

<div
  class={`fuma-aside not-content my-6 p-4 rounded-xl border`}
  style={`--callout-accent: ${accent};`}
>
  <div class="flex gap-3">
    <div class="mt-0.5 flex-shrink-0" style={`color: ${accent}`}>
      <Icon name={iconName} size="1.25rem" />
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-medium text-sl-color-text mb-1 leading-none">{displayTitle}</p>
      <div class="text-sm text-sl-color-gray-2 leading-relaxed prose-inline">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .fuma-aside {
    border-color: var(--sl-color-hairline);
    border-inline-start-width: 2px;
    border-inline-start-color: color-mix(in oklab, var(--callout-accent) 50%, transparent);
    background-color: var(--sl-color-bg-sidebar);
  }
  .prose-inline :global(p) {
    margin: 0.5rem 0;
  }
  .prose-inline :global(*:first-child) {
    margin-top: 0;
  }
  .prose-inline :global(*:last-child) {
    margin-bottom: 0;
  }
</style>
