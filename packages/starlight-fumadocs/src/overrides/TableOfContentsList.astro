---
interface TocItem {
	depth: number;
	slug: string;
	text: string;
	children: TocItem[];
}

interface Props {
	toc: TocItem[];
	depth?: number;
	isMobile?: boolean;
}

const { toc, isMobile = false, depth = 0 } = Astro.props;
---

<ul class:list={{ isMobile }}>
	{
		toc.map((heading) => (
			<li>
				<a href={'#' + heading.slug} aria-current={depth === 0 && heading.slug === '_top' ? 'true' : undefined}>
					<span>{heading.text}</span>
				</a>
				{heading.children.length > 0 && (
					<Astro.self toc={heading.children} depth={depth + 1} isMobile={isMobile} />
				)}
			</li>
		))
	}
</ul>

<style>
	ul {
		padding: 0;
		list-style: none;
	}
</style>
