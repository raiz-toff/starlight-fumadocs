---
import type { Props } from '@astrojs/starlight/props';
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-select>
	<div class="theme-toggle-container sl-flex">
		<button
			class="theme-toggle-button sl-flex"
			data-theme-value="light"
			title={Astro.locals.t('themeSelect.light')}
			aria-label={Astro.locals.t('themeSelect.light')}
		>
			<Icon name="sun" />
		</button>
		<button
			class="theme-toggle-button sl-flex"
			data-theme-value="auto"
			title={Astro.locals.t('themeSelect.auto')}
			aria-label={Astro.locals.t('themeSelect.auto')}
		>
			<Icon name="laptop" />
		</button>
		<button
			class="theme-toggle-button sl-flex"
			data-theme-value="dark"
			title={Astro.locals.t('themeSelect.dark')}
			aria-label={Astro.locals.t('themeSelect.dark')}
		>
			<Icon name="moon" />
		</button>
	</div>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro` */}
<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<style>
	starlight-theme-select {
		display: block;
	}

	.theme-toggle-container {
		align-items: center;
		background-color: hsla(var(--sl-color-bg-base), 0.4);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--fuma-radius);
		padding: 0.125rem;
		gap: 0.125rem;
	}

	.theme-toggle-button {
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: none;
		background: transparent;
		color: var(--sl-color-gray-3);
		border-radius: calc(var(--fuma-radius) - 2px);
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		padding: 0;
	}

	.theme-toggle-button:hover {
		color: var(--sl-color-white);
		background-color: hsla(var(--sl-color-white-base), 0.1);
	}

	.theme-toggle-button[aria-selected='true'] {
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		box-shadow: var(--sl-shadow-sm);
	}

	.theme-toggle-button :global(svg) {
		width: 1.125rem;
		height: 1.125rem;
	}
</style>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			const buttons = this.querySelectorAll<HTMLButtonElement>('button[data-theme-value]');
			
			const parseTheme = (theme: unknown): Theme =>
				theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

			const getPreferredColorScheme = (): Theme =>
				matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

			const updateState = () => {
				const theme = parseTheme(localStorage.getItem('starlight-theme'));
				buttons.forEach((btn) => {
					btn.setAttribute('aria-selected', btn.dataset.themeValue === theme ? 'true' : 'false');
				});
				
				// Apply theme to document
				document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
			};

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const theme = parseTheme(btn.dataset.themeValue);
					
					// Update localStorage
					localStorage.setItem('starlight-theme', theme === 'auto' ? '' : theme);
					
					// Update Pickers (including this one)
					if (typeof StarlightThemeProvider !== 'undefined') {
						StarlightThemeProvider.updatePickers(theme);
					}
					
					updateState();
				});
			});

			// React to system changes
			matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
				if (parseTheme(localStorage.getItem('starlight-theme')) === 'auto') {
					updateState();
				}
			});

			// Initial state
			updateState();
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>
