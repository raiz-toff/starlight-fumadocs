---
import type { Props } from '@astrojs/starlight/props';
import config from 'virtual:starlight/user-config';
import { logos } from 'virtual:starlight/user-images';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo ? (
			<img
				class="logo"
				src={logos.dark?.src}
				alt={config.logo.alt}
			/>
		) : (
			<span class="logo emoji-logo">🥮</span>
		)
	}
	<span class:list={[{ 'sr-only': config.logo?.replacesTitle }, 'title-text']} translate="no">
		{siteTitle}
	</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-white);
		transition: color 0.2s ease;
	}

	.logo {
		height: 1.625rem; /* ~26px */
		width: auto;
		flex-shrink: 0;
	}

	.emoji-logo {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.75rem; /* ~28px */
		line-height: 1;
	}

	.title-text {
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		white-space: nowrap;
		color: inherit;
	}

	.site-title:hover {
		color: var(--sl-color-accent-high);
	}

	@media (max-width: 30rem) { /* ~480px */
		.logo + .title-text {
			display: none;
		}
	}

	/* Also hide text in the mobile sidebar drawer regardless of screen width */
	:global(.sidebar-mobile) .title-text {
		display: none;
	}

	@media (max-width: 50rem) {
		.title-text {
			font-size: 1rem;
		}
	}
</style>
